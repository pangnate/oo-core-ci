{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdk-manifest.schema.json",
  "title": "Core feature SDK manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sdkId", "kind", "platform", "abi", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sdkId": {"type": "string", "minLength": 1},
    "kind": {"enum": ["development", "build", "runtime"]},
    "platform": {"enum": ["windows-amd64", "linux-amd64", "linux-arm64"]},
    "abi": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "status", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "status": {"enum": ["verified", "unavailable", "planned"]},
          "source": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reason": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]}, "then": {"required": ["path", "sha256"]}},
          {"if": {"properties": {"status": {"enum": ["unavailable", "planned"]}}, "required": ["status"]}, "then": {"required": ["reason"]}}
        ]
      }
    }
  }
}
