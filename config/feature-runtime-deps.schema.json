{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature-runtime-deps.schema.json",
  "title": "ONLYOFFICE Core feature runtime dependency lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lockId", "core", "windowsAmd64", "deferred", "anchors"],
  "properties": {
    "schemaVersion": {"const": 1},
    "lockId": {"type": "string", "minLength": 1},
    "core": {
      "type": "object",
      "required": ["ref", "treeSha256", "buildToolsRef", "buildToolsTreeSha256"],
      "properties": {
        "ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "treeSha256": {"$ref": "#/$defs/sha256"},
        "buildToolsRef": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "buildToolsTreeSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "windowsAmd64": {
      "type": "object",
      "required": ["toolchain", "thirdParty", "blockers"],
      "properties": {
        "toolchain": {"$ref": "#/$defs/items"},
        "thirdParty": {"$ref": "#/$defs/items"},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "deferred": {"type": "object", "additionalProperties": {"type": "string"}},
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "contains"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "contains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "status": {"enum": ["verified", "unavailable", "planned"]},
          "version": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "sourceRef": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "validation": {"type": "string"},
          "source": {"type": "string"},
          "reason": {"type": "string"}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]}, "then": {"anyOf": [{"required": ["path", "sha256"]}, {"required": ["sourceRef", "evidence"]}] }},
          {"if": {"properties": {"status": {"enum": ["unavailable", "planned"]}}, "required": ["status"]}, "then": {"required": ["reason"]}}
        ]
      }
    }
  }
}
