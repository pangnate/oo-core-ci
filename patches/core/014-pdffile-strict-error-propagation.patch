+	static bool SavePdfCandidateV1(CPdfFile* pPdf, const std::wstring& destination, ConversionResultV1* result)
+	{
+		COwnedPdfCandidateV1 candidate;
+		try
+		{
+			std::wstring directory = NSFile::GetDirectoryName(destination);
+			if (directory.empty()) directory = L".";
+			// Same directory/filesystem: do not use CFileBinary::Move (copy then delete).
+			candidate.path = CreatePdfCandidateV1(directory);
+			if (candidate.path.empty() || pPdf->SaveToFile(candidate.path) != 0)
+			{
+				SetConversionErrorV1(result, ConversionOutputFailedV1);
+				return false;
