+#if defined(_WIN32) || defined(_WIN64)
+			const bool published = ::MoveFileExW(candidate.path.c_str(), destination.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+#else
+			const std::string sourceUtf8 = U_TO_UTF8(candidate.path);
+			const std::string destinationUtf8 = U_TO_UTF8(destination);
+			const bool published = std::rename(sourceUtf8.c_str(), destinationUtf8.c_str()) == 0;
+#endif
+			if (published)
