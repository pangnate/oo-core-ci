+	static std::wstring CreatePdfCandidateV1(const std::wstring& directory)
+	{
+#if defined(_WIN32) || defined(_WIN64)
+		wchar_t path[MAX_PATH + 1] = {0};
+		if (!::GetTempFileNameW(directory.c_str(), L"cpf", 0, path))
+			return std::wstring();
+		try { return std::wstring(path); }
+		catch (...) { ::DeleteFileW(path); throw; }
+#else
+		std::string pattern = U_TO_UTF8(directory + L"/core-pdf-XXXXXX");
+		const int fd = ::mkstemp(&pattern[0]);
+		if (fd < 0)
+			return std::wstring();
+		::close(fd);
+		try { return NSFile::CUtf8Converter::GetUnicodeStringFromUTF8(reinterpret_cast<BYTE*>(&pattern[0]), static_cast<LONG>(pattern.size())); }
+		catch (...) { ::unlink(pattern.c_str()); throw; }
+#endif
