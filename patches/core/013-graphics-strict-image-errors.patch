+#ifndef _CORE_CONVERSION_POLICY_V1_H_
+#define _CORE_CONVERSION_POLICY_V1_H_
+
+#include <stdint.h>
+
+namespace NSOnlineOfficeBinToPdf
+{
+    // Additive POD contract. No existing renderer/parameter layout or vtable changes.
+    struct ConversionPolicyV1
+    {
+        uint32_t size;
+        uint32_t version;
+        uint32_t flags; // bit 0: fail on every non-S_OK image command
+    };
+    struct ConversionResultV1
+    {
+        uint32_t size;
+        uint32_t version;
+        uint32_t code;
+        uint32_t commandOffset;
+        uint32_t commandType;
+        int32_t rendererStatus;
+    };
+    enum ConversionErrorV1
+    {
+        ConversionOkV1 = 0,
+        ConversionImageFailedV1 = 1,
+        ConversionStreamFailedV1 = 2,
+        ConversionOutputFailedV1 = 3,
+        ConversionPolicyInvalidV1 = 4
+    };
+    inline void SetConversionErrorV1(ConversionResultV1* result, uint32_t code, int32_t status = 0)
+    {
+        if (result && result->code == ConversionOkV1)
+        {
+            result->code = code;
+            result->rendererStatus = status;
+        }
+    }
+    inline bool PrepareConversionV1(const ConversionPolicyV1* policy, ConversionResultV1* result)
+    {
+        // Never write through an unknown result layout.
+        if (!result || result->size != sizeof(ConversionResultV1) || result->version != 1)
+            return false;
+        result->code = ConversionOkV1;
+        result->commandOffset = 0;
+        result->commandType = 0;
+        result->rendererStatus = 0;
+        if (!policy || policy->size != sizeof(ConversionPolicyV1) || policy->version != 1 || (policy->flags & ~1u))
+        {
+            result->code = ConversionPolicyInvalidV1;
+            return false;
+        }
+        return true;
+    }
+}
+
+#endif
